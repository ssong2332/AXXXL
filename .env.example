# 실제 값은 .env에만 적는다 (커밋 금지, .gitignore가 이미 제외).
# 이 파일은 플레이스홀더만 담아 추적한다 — 새 환경 변수를 추가하면 여기도 같이 갱신한다.

# Vercel 프로젝트 환경변수 (모두 선택 — 없으면 해당 기능이 규칙 기반·연습 모드로 동작)
# AI 공고 추출·AI 자취 코치 (Claude)
ANTHROPIC_API_KEY=
# 운영자 콘솔 코드 (길고 추측하기 어려운 값)
ADMIN_TOKEN=
# 승인본 공유 저장소 (Vercel Blob 저장소를 프로젝트에 연결하면 자동으로 생김)
BLOB_READ_WRITE_TOKEN=
# 주소 검색 (카카오 로컬)
KAKAO_REST_KEY=
# 공공데이터포털 상가정보
DATA_GO_KR_KEY=
