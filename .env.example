# 실제 값은 .env에만 적는다 (커밋 금지, .gitignore가 이미 제외).
# 이 파일은 플레이스홀더만 담아 추적한다 — 새 환경 변수를 추가하면 여기도 같이 갱신한다.

# Vercel 프로젝트 환경변수 (모두 선택 — 없으면 해당 기능이 규칙 기반·연습 모드로 동작)
# AI 공고 추출·AI 자취 코치 (Claude)
ANTHROPIC_API_KEY=
# 운영자 콘솔 코드 (길고 추측하기 어려운 값)
ADMIN_TOKEN=
# 승인본 공유 저장소 (Vercel Blob 저장소를 프로젝트에 연결하면 자동으로 생김)
BLOB_READ_WRITE_TOKEN=
# 주소 검색 (카카오 로컬)
KAKAO_REST_KEY=
# 공공데이터포털 (한 계정에 키 하나): 상가정보, 지자체·중앙부처 복지서비스, LH 분양임대공고, 특일 정보
# API마다 활용신청은 따로 한다. 인코딩 전 값(Decoding)과 인코딩된 값 모두 받는다
DATA_GO_KR_KEY=
# 온통청년 청년정책 (https://www.youthcenter.go.kr 오픈 API 인증키) — 지원사업 화면의 지역별 정책 목록
YOUTH_API_KEY=
# 카카오 지도 JavaScript 키 (브라우저용, 카카오 콘솔에 등록한 도메인에서만 열림)
KAKAOMAPSDK_KEY=
# 카카오 REST 키 (주변 장소·도보 경로). 예전 이름 KAKAO_REST_KEY 도 받는다
KAKAOREST_API_KEY=
# 국토교통부 TAGO 버스정류장 (공공데이터포털)
TAGO_API_KEY=
# 선택: ANTHROPIC_API_KEY 대신 쓰는 인증 토큰
ANTHROPIC_AUTH_TOKEN=

# 로그인·기기 간 이어 보기 (Supabase). publishable 키만 쓴다 — service_role·secret 키는 넣지 않는다
# 테이블·권한: supabase/user_state.sql
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 기한 알림(웹 푸시). 테이블·권한: supabase/push.sql
# VAPID 키 만들기: cd demo && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Vercel 크론 인증 (32자 이상 무작위 값). sha256 해시를 Supabase private.push_key 에 넣는다
CRON_SECRET=

# 로컬 서버 포트 (demo/dev-server.js, 기본 4173)
PORT=
